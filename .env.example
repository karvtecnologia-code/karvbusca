# ===== KarvBusca — variáveis de ambiente =====
# Painel local: copie para apps/web/.env.local. Na Vercel e no GitHub, cadastre nos lugares indicados no README.
# NUNCA comite valores reais.

# --- Supabase (Project Settings > API Keys / Data API) — obrigatório ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# só no servidor (Vercel e GitHub Secrets), nunca com NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# --- Telegram — OPCIONAL: o normal é cadastrar o token em Configurações (fica no Vault) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- GitHub — opcional, para o botão "Rodar agora" na tela Saúde ---
# fine-grained token com "Actions: Read and write" só no seu repositório
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=seu-usuario/seu-repositorio
