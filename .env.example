# ===== KarvBusca — variáveis de ambiente =====
# Copie para apps/web/.env.local (painel) e cadastre as mesmas nos lugares indicados.
# NUNCA comite valores reais.

# --- Supabase (Project Settings > API) ---
# Vercel + .env.local + GitHub Secrets
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só servidor: Vercel + GitHub Secrets (nunca NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# --- Telegram (fase 3) ---
# Vercel + GitHub Secrets
TELEGRAM_BOT_TOKEN=
# Texto aleatório longo que você inventa; o Telegram manda de volta no header do webhook
TELEGRAM_WEBHOOK_SECRET=

# --- GitHub (botão "rodar agora", fase 2) ---
# Só Vercel: fine-grained token com permissão Actions: Read and write no repo karvbusca
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=karvtecnologia-code/karvbusca
